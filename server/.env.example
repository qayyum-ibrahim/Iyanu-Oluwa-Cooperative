# Pooled address of the database, used by the app (Neon: the "-pooler" host). Make your own in server/.env.
DATABASE_URL=
# Direct address of the same database, used by the Prisma CLI (migrate deploy). Never commit either.
DIRECT_URL=
# Signing secret for access tokens. At least 32 bytes. Make your own value in server/.env. Never commit it.
TOKEN_SECRET=
# SMS provider: fake (the default, sends nothing), twilio (D-121) or termii (E.10). Fake values only in tests.
SMS_PROVIDER=
# Twilio settings, needed only when SMS_PROVIDER=twilio. Make an API key in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
# The API key secret. Never commit it or paste it in chat.
TWILIO_API_KEY_SECRET=
# The sender: a Twilio number in E.164 (for example +1...) or a registered sender ID.
TWILIO_FROM=
# Termii settings, needed only when SMS_PROVIDER=termii. The base URL is your account's own, from the Termii dashboard (https).
TERMII_BASE_URL=
# The Termii API key (dashboard, API token). Never commit it or paste it in chat.
TERMII_API_KEY=
# An approved Termii sender ID, 3 to 11 characters.
TERMII_SENDER_ID=
# Proxies in front of the server: empty or 0 locally (X-Forwarded-For ignored); on Render, the number checked at E.8 (D-122).
TRUST_PROXY_HOPS=
