// Database schema. Users, the audit log and refresh tokens (step 2.3c), sign-in lockout (step 2.3e),
// stored staff permissions (step 2.5b), members (step 3.1), payments (step 4.2), expenses (step 5.2),
// loans (step 5.3), loan links on payment lines and expenses (step 5.3b), loan idempotency keys (step 5.4c),
// expense idempotency keys (step 5.7c), pay-offs (step 6.3).
// Money columns are BigInt kobo (D-15).
// All timestamps are stored in UTC (D-16).

generator client {
  provider                = "prisma-client"
  output                  = "../src/generated/prisma"
  moduleFormat            = "esm"
  generatedFileExtension  = "ts"
  importFileExtension     = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  STAFF
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  displayName      String
  role             Role           @default(STAFF)
  isActive         Boolean        @default(true)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  // JSON text of permission names, e.g. ["dashboard","members.view"] (D-34). Only Staff use it.
  permissions      String         @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
  members          Member[]
  payments         Payment[]
  expenses         Expense[]      @relation("ExpenseCreatedBy")
  deletedExpenses  Expense[]      @relation("ExpenseDeletedBy")
  loans            Loan[]
  payOffs          PayOff[]
}

model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String?
  detail     String?

  @@index([createdAt])
  @@index([actorId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  @@index([userId])
  @@index([familyId])
}

model Member {
  id          String       @id @default(uuid())
  // The number behind the Membership ID: 1 is IO-001. Never reused.
  seq         Int          @unique
  fullName    String
  phone       String       @default("")
  address     String       @default("")
  occupation  String       @default("")
  status      MemberStatus @default(ACTIVE)
  // The user who recorded the member (DR-13, DR-15). A user with members cannot be deleted.
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  payments    Payment[]
  loans       Loan[]
  payOffs     PayOff[]

  @@index([createdById])
}

// Append-only (D-17): no update or delete exists in the store. A correction is a new reversing entry.
model Payment {
  id          String        @id @default(uuid())
  memberId    String
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  method      PaymentMethod
  // Whole kobo (D-15). The lines add up to this; the logic code checks it (DR-02).
  totalKobo   BigInt
  // The day the member paid, as "YYYY-MM-DD" in Lagos time (step U.4a). Rows saved before it
  // got the day of createdAt in Lagos.
  paidOn      String
  // Set when the caller sent an Idempotency-Key (step 4.5, D-47). Old rows have none.
  idempotencyKey String?
  requestHash    String?
  // The user who recorded the payment (DR-15).
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  lines       PaymentLine[]

  @@index([memberId])
  @@index([createdById])
  // For the day range of payments.list (step 7.1).
  @@index([paidOn])
  @@unique([createdById, idempotencyKey])
}

model PaymentLine {
  id         String  @id @default(uuid())
  paymentId  String
  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  // Order of the line inside the payment, first line is 0.
  position   Int
  category   String
  amountKobo BigInt
  // The loan a Loan Repaid line pays back (DR-09, A-145). Null for every other line. The logic
  // code decides which lines get one (step 5.5); the store only checks that the loan exists.
  loanId     String?
  loan       Loan?   @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@unique([paymentId, position])
  @@index([loanId])
}

// Money going out (DR-11, D-54). Soft-delete only (D-10, DR-12): deletedAt and deletedById are set
// at step 5.9; nothing deletes a row. The category is text, checked by the logic code (A-148).
model Expense {
  id          String        @id @default(uuid())
  category    String
  // Whole kobo (D-15).
  amountKobo  BigInt
  method      PaymentMethod
  description String        @default("")
  // The free text for "Others" (DR-11). Empty for other categories.
  narration   String        @default("")
  // The day the money left, "YYYY-MM-DD" in Lagos time (step U.6a). A Loan expense has its loan's givenOn.
  spentOn     String
  // The loan this expense pays out (DR-10). At most one expense per loan (A-148).
  loanId      String?       @unique
  loan        Loan?         @relation(fields: [loanId], references: [id], onDelete: Restrict)
  // The pay-off this Membership Withdrawal expense pays out (DR-05, step 6.3b). At most one expense per pay-off.
  payOffId    String?       @unique
  payOff      PayOff?       @relation(fields: [payOffId], references: [id], onDelete: Restrict)
  // Set from the Idempotency-Key header of POST /expenses (step 5.7c). Loan expenses and old rows have none.
  idempotencyKey String?
  requestHash    String?
  // The user who recorded the expense (DR-15).
  createdById String
  createdBy   User          @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?         @relation("ExpenseDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([createdAt])
  @@index([spentOn])
  @@unique([createdById, idempotencyKey])
}

// A loan given to a member (D-54). No repaid or outstanding amount is stored: both are worked out
// on read from the Loan Repaid lines (D-17, A-144). No update or delete exists (OQ-16).
model Loan {
  id            String   @id @default(uuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  // Whole kobo (D-15).
  principalKobo BigInt
  // Information only, no formula (D-02, A-146).
  interestNote  String   @default("")
  notes         String   @default("")
  // The day the loan was given, "YYYY-MM-DD" in Lagos (step U.5a). Old rows get the day of
  // createdAt in Lagos (migration 20261023120000_loan_given_on).
  givenOn       String
  // Set from the Idempotency-Key header (step 5.4c, D-60). Old rows have none.
  idempotencyKey String?
  requestHash    String?
  // The user who gave the loan (DR-15).
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  repayments    PaymentLine[]
  expense       Expense?

  @@index([memberId])
  @@index([createdById])
  @@unique([createdById, idempotencyKey])
}

// A pay-off (DR-05, step 6.3). Append-only (D-17): no update or delete exists in the store. The
// lines hold what was paid out of each refundable category, so balances can take it off (A-180).
model PayOff {
  id             String        @id @default(uuid())
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  method         PaymentMethod
  // Whole kobo (D-15). The lines add up to this; the logic code checks it.
  totalKobo      BigInt
  // Set from the Idempotency-Key header of the pay-off route (step 6.4).
  idempotencyKey String?
  requestHash    String?
  // The user who processed the pay-off (DR-15).
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  lines          PayOffLine[]
  expense        Expense?

  @@index([memberId])
  @@index([createdById])
  @@unique([createdById, idempotencyKey])
}

model PayOffLine {
  id         String @id @default(uuid())
  payOffId   String
  payOff     PayOff @relation(fields: [payOffId], references: [id], onDelete: Restrict)
  // Order of the line inside the pay-off, first line is 0.
  position   Int
  category   String
  amountKobo BigInt

  @@unique([payOffId, position])
}
