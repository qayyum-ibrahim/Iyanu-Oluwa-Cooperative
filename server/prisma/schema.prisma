// Database schema. Users, the audit log and refresh tokens (step 2.3c), sign-in lockout (step 2.3e).
// Money tables arrive in Phase 3 and later. Money columns will be BigInt kobo (D-15).
// All timestamps are stored in UTC (D-16).

generator client {
  provider                = "prisma-client"
  output                  = "../src/generated/prisma"
  moduleFormat            = "esm"
  generatedFileExtension  = "ts"
  importFileExtension     = "js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPER_ADMIN
  STAFF
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  displayName      String
  role             Role           @default(STAFF)
  isActive         Boolean        @default(true)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
}

model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String?
  detail     String?

  @@index([createdAt])
  @@index([actorId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  @@index([userId])
  @@index([familyId])
}