# Pooled address of the database, used by the app (Neon: the "-pooler" host). Make your own in server/.env.
DATABASE_URL=
# Direct address of the same database, used by the Prisma CLI (migrate deploy). Never commit either.
DIRECT_URL=
# Signing secret for access tokens. At least 32 bytes. Make your own value in server/.env. Never commit it.
TOKEN_SECRET=
# SMS provider: fake (the default, sends nothing) or twilio (D-121). Fake values only in tests.
SMS_PROVIDER=
# Twilio settings, needed only when SMS_PROVIDER=twilio. Make an API key in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
# The API key secret. Never commit it or paste it in chat.
TWILIO_API_KEY_SECRET=
# The sender: a Twilio number in E.164 (for example +1...) or a registered sender ID.
TWILIO_FROM=
