// Database schema. Users, the audit log and refresh tokens (step 2.3c), sign-in lockout (step 2.3e),
// stored staff permissions (step 2.5b), members (step 3.1), payments (step 4.2).
// Money columns are BigInt kobo (D-15).
// All timestamps are stored in UTC (D-16).

generator client {
  provider                = "prisma-client"
  output                  = "../src/generated/prisma"
  moduleFormat            = "esm"
  generatedFileExtension  = "ts"
  importFileExtension     = "js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPER_ADMIN
  STAFF
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  displayName      String
  role             Role           @default(STAFF)
  isActive         Boolean        @default(true)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  // JSON text of permission names, e.g. ["dashboard","members.view"] (D-34). Only Staff use it.
  permissions      String         @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
  members          Member[]
  payments         Payment[]
}

model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String?
  detail     String?

  @@index([createdAt])
  @@index([actorId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  @@index([userId])
  @@index([familyId])
}

model Member {
  id          String       @id @default(uuid())
  // The number behind the Membership ID: 1 is IO-001. Never reused.
  seq         Int          @unique
  fullName    String
  phone       String       @default("")
  address     String       @default("")
  occupation  String       @default("")
  status      MemberStatus @default(ACTIVE)
  // The user who recorded the member (DR-13, DR-15). A user with members cannot be deleted.
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  payments    Payment[]

  @@index([createdById])
}

// Append-only (D-17): no update or delete exists in the store. A correction is a new reversing entry.
model Payment {
  id          String        @id @default(uuid())
  memberId    String
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  method      PaymentMethod
  // Whole kobo (D-15). The lines add up to this; the logic code checks it (DR-02).
  totalKobo   BigInt
  // The user who recorded the payment (DR-15).
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  lines       PaymentLine[]

  @@index([memberId])
  @@index([createdById])
}

model PaymentLine {
  id         String  @id @default(uuid())
  paymentId  String
  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  // Order of the line inside the payment, first line is 0.
  position   Int
  category   String
  amountKobo BigInt

  @@unique([paymentId, position])
}